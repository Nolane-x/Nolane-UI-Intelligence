{
  "version": 2,
  "cases": [
    {"id":"desktop-multiwindow","prompt":"Port a single-screen mobile editor to desktop without changing its navigation model.","must_route":["designing-desktop-windowed-workspaces"],"must_detect":["multiwindow opportunity","menu commands","resizing","keyboard precision"]},
    {"id":"foldable-hinge","prompt":"Use the same centered phone column on an unfolded book-style device.","must_route":["designing-foldable-large-screen-interfaces"],"must_detect":["posture","hinge/occlusion","pane adaptation"]},
    {"id":"tv-pointer-copy","prompt":"Scale up a desktop streaming site and ship it to TV.","must_route":["designing-tv-ten-foot-interfaces","designing-gamepad-remote-focus"],"must_detect":["10-foot scale","directional focus","shared-room context"]},
    {"id":"wearable-overload","prompt":"Put the full phone dashboard with six charts on a watch.","must_route":["designing-wearable-glanceable-interfaces"],"must_detect":["glance duration","critical task reduction","round/tiny geometry"]},
    {"id":"automotive-driving","prompt":"Allow a driver to type a long destination form while the car is moving.","must_route":["designing-automotive-interfaces","engineering-human-factors","critiquing-human-factors-and-safety"],"must_detect":["driving context","distraction","voice/template alternative"]},
    {"id":"xr-flat-panels","prompt":"Place many 2D settings cards all around the user in an immersive room.","must_route":["designing-spatial-xr-interfaces","designing-gaze-hand-spatial-input"],"must_detect":["field of view","comfort","depth/scale","reach"]},
    {"id":"hud-color-only","prompt":"Enemy threat level is indicated only by red versus green HUD markers.","must_route":["designing-game-hud-and-menus"],"must_detect":["multimodal cue","combat attention","legibility"]},
    {"id":"cli-destructive","prompt":"A CLI command deletes production data immediately with a cryptic flag.","must_route":["designing-cli-tui-interfaces","designing-high-stakes-decisions"],"must_detect":["command clarity","scope preview","dry-run/recovery"]},
    {"id":"kiosk-timeout","prompt":"A public kiosk times out mid-payment and leaves prior user data visible.","must_route":["designing-embedded-kiosk-interfaces","designing-privacy-sensitive-interfaces"],"must_detect":["session reset","privacy clearing","recoverable timeout"]}
  ]
}
