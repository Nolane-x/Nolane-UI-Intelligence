      "expected_decision": "BLOCKED",
      "evidence_requirements": [
        "component source path",
        "demo/runtime context",
        "motion/reduced-motion evidence",
        "pinned snapshot"
      ],
      "evaluator_owner": "auditing-ui-research-depth"
    },
    {
      "id": "v6-high-drift-unpinned-source",
      "required_skills": [
        "performing-ui-repository-archaeology"
      ],
      "setup": "A high-drift component repository is described from memory/current docs with no commit or tag.",
