      "expected_decision": "RESEARCH_MORE",
      "evidence_requirements": [
        "canonical source identity",
        "current ref",
        "commit snapshot",
        "retrieved_at"
      ],
      "evaluator_owner": "auditing-ui-research-depth"
    },
