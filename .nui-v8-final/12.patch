diff --git a/scripts/nui-media-query b/scripts/nui-media-query
new file mode 100755
index 0000000..bcff0c4
--- /dev/null
+++ b/scripts/nui-media-query
@@ -0,0 +1,14 @@
+#!/usr/bin/env python3
+import argparse, json
+from pathlib import Path
+ROOT=Path(__file__).resolve().parents[1]
+p=argparse.ArgumentParser(description="Query NUI's rights-aware media source registry")
+p.add_argument("--class",dest="cls")
+p.add_argument("--best-for",dest="best")
+a=p.parse_args()
+data=json.loads((ROOT/"knowledge/visual-media-sources-v8.json").read_text())
+items=data.get("sources",[])
+if a.cls: items=[x for x in items if x.get("class")==a.cls]
+if a.best:
+    q=a.best.lower(); items=[x for x in items if q in " ".join(map(str,x.get("best_for",[]))).lower()]
+print(json.dumps(items,indent=2,ensure_ascii=False))
