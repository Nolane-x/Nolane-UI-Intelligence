diff --git a/schemas/agent-interoperability.schema.json b/schemas/agent-interoperability.schema.json
new file mode 100644
index 0000000..8c6cbcb
--- /dev/null
+++ b/schemas/agent-interoperability.schema.json
@@ -0,0 +1,61 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "title": "NUI v8 Agent Interoperability Registry",
+  "type": "object",
+  "required": [
+    "version",
+    "adapters"
+  ],
+  "properties": {
+    "version": {
+      "const": 8
+    },
+    "adapters": {
+      "type": "array",
+      "minItems": 5,
+      "items": {
+        "type": "object",
+        "required": [
+          "id",
+          "surface",
+          "canonical_graph",
+          "copy_policy",
+          "evidence",
+          "permission_boundary",
+          "authority_escalation"
+        ],
+        "properties": {
+          "id": {"type":"string","minLength":1},
+          "surface": {"type":"string","minLength":1},
+          "canonical_graph": {"const":"skills/skill-graph.json"},
+          "copy_policy": {"enum":["thin-bridge","pointer-only","host-native-pointer"]},
+          "evidence": {"type":"array","minItems":1},
+          "permission_boundary": {"type":"string","minLength":12},
+          "authority_escalation": {"const":false}
+        }
+      }
+    }
+  }
+}
