--- /dev/null
+++ b/scripts/nui-agent-export
@@ -0,0 +1,10 @@
+#!/usr/bin/env python3
+import argparse, json, sys
+from pathlib import Path
+ROOT=Path(__file__).resolve().parents[1]
+sys.path.insert(0,str(ROOT/"src"))
+from nolane_ui.interop import build_agent_install_plan
+p=argparse.ArgumentParser(description="Emit a bounded NUI agent-integration plan")
+p.add_argument("--agent",required=True)
+a=p.parse_args()
+print(json.dumps(build_agent_install_plan(a.agent,ROOT),indent=2,ensure_ascii=False))
