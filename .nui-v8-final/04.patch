+      "falsifier": "Disable animation and compare state comprehension.",
+      "recovery": "Remove decorative motion or rewrite choreography around state continuity.",
+      "evaluator_owner": "orchestrating-creative-toolchains"
+    },
+    {
+      "id": "threejs-performance-envelope",
+      "setup": "A WebGL signature is visually impressive.",
+      "pressure": "GPU/interaction cost on target devices exceeds budget.",
