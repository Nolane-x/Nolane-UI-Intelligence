+    },
+    {
+      "id": "blender-source-preservation",
+      "setup": "A 3D asset is rendered in Blender for a product hero.",
+      "pressure": "Only final PNG is retained.",
+      "expected_decision": "BLOCKED",
+      "must_find": [
+        "editable source remains available",
+        "handoff records camera/material/export contract"
