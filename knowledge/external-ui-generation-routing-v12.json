{
  "version": 12,
  "as_of": "2026-08-22",
  "policy": {
    "purpose": "Deterministic generation-time routing into bounded V12 external UI reference packs. Signals trigger research packets, never blanket authority.",
    "max_active_packs": 8,
    "max_sources_per_pack": 3,
    "max_active_source_ids": 12,
    "material_ui_baseline_packs": [
      "accessibility-verification",
      "performance-quality"
    ],
    "stack_baselines": {
      "react": ["react-application-system"],
      "nextjs": ["react-application-system"],
      "react-native": ["native-component-system", "native-motion"],
      "react native": ["native-component-system", "native-motion"],
      "ios": ["native-component-system"],
      "android": ["native-component-system"]
    }
  },
  "rules": [
    {"id":"ai-chat","priority":120,"match_any":["ai chat","chat","assistant","conversation","streaming response","streaming message"],"packs":["ai-chat"]},
    {"id":"agent-approval","priority":118,"match_any":["human approval","human-in-the-loop","human in the loop","approval","approve tool","confirm tool"],"packs":["agent-approval-human-loop"]},
    {"id":"agent-tool","priority":116,"match_any":["tool call","tool calls","agent tool","copilot","agent ui","agentic","mcp app"],"packs":["agent-tool-ui"]},
    {"id":"generative-ui","priority":114,"match_any":["generative ui","generated ui","dynamic ui","a2ui"],"packs":["generative-ui"]},
    {"id":"semantic-icon","priority":112,"match_any":["icon transition","icon morph","morph icon","icon state","mute","speaker off","toggle icon"],"packs":["semantic-icon-transition"]},
    {"id":"button-feedback","priority":110,"match_any":["button","cta","press feedback","click feedback","send button","submit button"],"packs":["button-feedback"]},
    {"id":"loading-state","priority":108,"match_any":["loading","success state","error state","async action","progress state"],"packs":["loading-success-error"]},
    {"id":"microinteraction","priority":106,"match_any":["microinteraction","micro-interaction","animated","animation","hover","press","spring"],"packs":["microinteraction"]},
    {"id":"layout-transition","priority":104,"match_any":["layout transition","shared layout","reorder animation","view transition"],"packs":["layout-transition"]},
    {"id":"gesture","priority":102,"match_any":["gesture","swipe","pinch","pan","drag gesture"],"packs":["gesture-interaction"]},
    {"id":"dialog-popover","priority":100,"match_any":["dialog","popover","tooltip","menu","select","disclosure"],"packs":["accessible-dialog-popover"]},
    {"id":"focus-keyboard","priority":99,"match_any":["keyboard","focus management","focus trap","roving tabindex"],"packs":["focus-keyboard-management"]},
    {"id":"command-menu","priority":98,"match_any":["command menu","command palette","cmdk","quick action palette"],"packs":["command-menu"]},
    {"id":"drawer-sheet","priority":97,"match_any":["drawer","sheet","bottom sheet","side sheet"],"packs":["drawer-sheet"]},
    {"id":"drag-drop","priority":96,"match_any":["drag drop","drag-and-drop","drag and drop","sortable","reorder","kanban"],"packs":["drag-drop"]},
    {"id":"resizable-workspace","priority":95,"match_any":["resizable","split panel","dock","workspace panel","resize panel"],"packs":["resizable-workspace"]},
    {"id":"selection-manipulation","priority":94,"match_any":["selection box","multi-select","transform handles","resize handles","object manipulation"],"packs":["selection-manipulation"]},
    {"id":"shadcn","priority":93,"match_any":["shadcn","copy component","component registry"],"packs":["copy-own-shadcn"]},
    {"id":"enterprise","priority":92,"match_any":["enterprise","admin console","admin dashboard","operations console","backoffice"],"packs":["enterprise-admin-ui"]},
    {"id":"public-service","priority":91,"match_any":["public service","government","govuk","citizen service"],"packs":["public-service-ui"]},
    {"id":"expressive-cta","priority":90,"match_any":["landing page","hero cta","expressive cta","marketing hero"],"packs":["expressive-cta"]},
    {"id":"rich-text","priority":89,"match_any":["rich text","contenteditable","document editor","wysiwyg","markdown editor"],"packs":["rich-text-editor"]},
    {"id":"code-editor","priority":88,"match_any":["code editor","ide","source editor","monaco","codemirror"],"packs":["code-editor"]},
    {"id":"collaborative-editor","priority":87,"match_any":["collaborative editor","real-time collaboration","realtime collaboration","crdt","multiplayer document"],"packs":["collaborative-editor"]},
    {"id":"infinite-canvas","priority":86,"match_any":["infinite canvas","whiteboard","drawing canvas","spatial canvas"],"packs":["infinite-canvas"]},
    {"id":"node-editor","priority":85,"match_any":["node editor","node graph","workflow editor","flow editor","visual programming"],"packs":["node-editor"]},
    {"id":"data-table","priority":84,"match_any":["data table","data grid","spreadsheet","virtualized table","large table"],"packs":["data-table"]},
    {"id":"dashboard-chart","priority":83,"match_any":["dashboard chart","chart dashboard","business chart","kpi chart"],"packs":["dashboard-chart"]},
    {"id":"analytical-viz","priority":82,"match_any":["data visualization","analytical visualization","scientific visualization","d3","vega","plot"],"packs":["analytical-visualization"]},
    {"id":"time-series","priority":81,"match_any":["time series","timeseries","financial chart","trading chart","stock chart"],"packs":["time-series"]},
    {"id":"spatial-3d","priority":80,"match_any":["3d","spatial ui","webgl","three.js","threejs","scene graph"],"packs":["spatial-3d"]},
    {"id":"vector-animation","priority":79,"match_any":["rive","lottie","vector animation","interactive vector"],"packs":["interactive-vector-animation"]},
    {"id":"native-motion","priority":78,"match_any":["react native animation","native motion","reanimated","mobile gesture"],"packs":["native-motion"]},
    {"id":"native-system","priority":77,"match_any":["react native","mobile ui","native component","ios ui","android ui"],"packs":["native-component-system"]},
    {"id":"native-navigation","priority":76,"match_any":["mobile navigation","native navigation","bottom sheet navigation","react navigation"],"packs":["native-navigation-sheet"]},
    {"id":"design-tokens","priority":75,"match_any":["design token","design tokens","token system","theme tokens","theming"],"packs":["design-tokens"]},
    {"id":"styling","priority":74,"match_any":["styling architecture","tailwind","css architecture","vanilla extract","stylex","panda css"],"packs":["styling-architecture"]},
    {"id":"visual-regression","priority":73,"match_any":["visual regression","screenshot test","pixel diff","snapshot visual"],"packs":["visual-regression"]},
    {"id":"accessibility","priority":72,"match_any":["accessibility","a11y","wcag","screen reader","aria"],"packs":["accessibility-verification"]},
    {"id":"performance","priority":71,"match_any":["performance","lighthouse","web vitals","render performance","fps"],"packs":["performance-quality"]},
    {"id":"application-system","priority":40,"match_any":["application ui","app ui","component system","design system","web app"],"packs":["react-application-system"]}
  ]
}
