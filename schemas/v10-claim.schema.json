{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nolane.ai/schemas/v10-claim.schema.json",
  "title": "NUI V10 Bounded Efficacy Claim",
  "type": "object",
  "additionalProperties": false,
  "required": ["claim_id", "requested_status", "dimension", "bounded_claim"],
  "properties": {
    "claim_id": {"type": "string", "minLength": 1},
    "requested_status": {"enum": ["STRUCTURAL_ONLY", "EMPIRICAL_LOCAL", "EMPIRICAL_TRANSFER", "REJECTED"]},
    "dimension": {"type": "string", "minLength": 1},
    "hypothesis_id": {"type": "string", "minLength": 1},
    "bounded_claim": {"type": "string", "minLength": 1},
    "models": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "task_splits": {"type": "array", "items": {"enum": ["dev", "holdout"]}, "uniqueItems": true},
    "runtime_scope": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "unresolved_regressions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "empirical_bundle_digests": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}, "uniqueItems": true}
  }
}
