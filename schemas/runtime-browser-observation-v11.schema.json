{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nolane.dev/schemas/runtime-browser-observation-v11.schema.json",
  "title": "NUI V11 Runtime Browser Observation",
  "type": "object",
  "required": ["version", "collector", "url", "viewport", "capabilities", "observations", "runtime_errors"],
  "properties": {
    "version": {"const": 11},
    "collector": {"type": "string", "minLength": 1},
    "url": {"type": "string", "minLength": 1},
    "viewport": {
      "type": "object",
      "required": ["width", "height", "dpr"],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "dpr": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "required": ["geometry", "computed_style", "runtime_errors", "capture"],
      "properties": {
        "geometry": {"type": "boolean"},
        "computed_style": {"type": "boolean"},
        "runtime_errors": {"type": "boolean"},
        "capture": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "capture_ref": {"type": "string", "minLength": 1},
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["locator"],
        "properties": {
          "locator": {"type": "string", "minLength": 1},
          "visible_text": {"type": "string"},
          "attributes": {"type": "object"},
          "computed_style": {"type": "object"},
          "bounding_box": {
            "type": "object",
            "required": ["x", "y", "width", "height"],
            "properties": {
              "x": {"type": "number"},
              "y": {"type": "number"},
              "width": {"type": "number", "exclusiveMinimum": 0},
              "height": {"type": "number", "exclusiveMinimum": 0}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": true
      }
    },
    "runtime_errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "message"],
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "message": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
