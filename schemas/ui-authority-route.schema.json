{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nolane.dev/schemas/ui-authority-route-v7.schema.json",
  "title": "NUI v7 UI Authority Route",
  "type": "object",
  "required": ["decisions"],
  "properties": {
    "status": {"enum": ["PASS", "PARTIAL", "BLOCKED"]},
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["dimension", "source_id", "role", "reason"],
        "properties": {
          "dimension": {"type": "string", "minLength": 1},
          "source_id": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "live_verification": {"type": "object"}
        }
      }
    },
    "unresolved_dimensions": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
