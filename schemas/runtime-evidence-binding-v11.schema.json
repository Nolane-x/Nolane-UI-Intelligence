{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nolane.dev/schemas/runtime-evidence-binding-v11.schema.json",
  "title": "NUI V11 Runtime Evidence Binding",
  "type": "object",
  "required": ["version", "evidence_id", "revision", "source_digests", "artifacts"],
  "properties": {
    "version": {"const": 11},
    "evidence_id": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "minLength": 1},
    "source_digests": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": true
}
