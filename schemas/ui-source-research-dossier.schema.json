{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://nolane.dev/schemas/ui-source-research-dossier.schema.json",
  "title":"NUI v6 UI Source Research Dossier",
  "type":"object",
  "required":["source_id","source_role","usage","snapshot","task_fit","inspected_artifacts","mechanisms","unread_material","stop_reason"],
  "properties":{
    "source_id":{"type":"string","minLength":1},
    "source_role":{"type":"string","minLength":1},
    "usage":{"enum":["adopt","adapt","inspire","build","reject"]},
    "visual_ambition":{"type":"string"},"risk_class":{"type":"string"},
    "snapshot":{"type":"object","required":["canonical_url","ref","retrieved_at"],"properties":{"canonical_url":{"type":"string","format":"uri"},"ref":{"type":"string","minLength":1},"commit_sha":{"type":"string"},"retrieved_at":{"type":"string","minLength":1}}},
    "task_fit":{"type":"object","required":["need","why_this_source","source_role_fit"],"properties":{"need":{"type":"string","minLength":1},"why_this_source":{"type":"string","minLength":1},"source_role_fit":{"type":"boolean"}}},
    "inspected_artifacts":{"type":"array","minItems":1,"items":{"type":"object","required":["kind","path","finding","evidence_ref"],"properties":{"kind":{"type":"string","minLength":1},"path":{"type":"string","minLength":1},"finding":{"type":"string","minLength":1},"evidence_ref":{"type":"string","minLength":1}}}},
    "mechanisms":{"type":"array","items":{"type":"object","required":["name","evidence_artifact_paths","transfer_boundary","product_fit"],"properties":{"name":{"type":"string","minLength":1},"evidence_artifact_paths":{"type":"array","minItems":1,"items":{"type":"string"}},"transfer_boundary":{"type":"string","minLength":1},"product_fit":{"type":"string","minLength":1}}}},
    "contradictions":{"type":"array"},"integration_hazards":{"type":"array"},
    "license":{"type":"object"},"accessibility":{"type":"object"},"performance":{"type":"object"},
    "unread_material":{"type":"array"},"stop_reason":{"type":"string","minLength":1}
  },"additionalProperties":true
}
