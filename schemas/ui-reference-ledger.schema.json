{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NUI UI Reference Ledger",
  "type": "object",
  "required": [
    "references"
  ],
  "properties": {
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "url",
          "usage",
          "mechanism",
          "inspected",
          "adaptation_boundary"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "usage": {
            "enum": [
              "adopt",
              "adapt",
              "inspire",
              "build",
              "reject"
            ]
          },
          "mechanism": {
            "type": "string",
            "minLength": 3
          },
          "inspected": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "adaptation_boundary": {
            "type": "string",
            "minLength": 3
          },
          "verified_at": {
            "type": "string"
          },
          "commit_or_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
