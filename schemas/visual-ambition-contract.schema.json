{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NUI v5 Visual Ambition Contract",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "level",
    "visual_freedom",
    "mandatory_routes",
    "trigger_evidence"
  ],
  "properties": {
    "level": {
      "enum": [
        "utilitarian",
        "polished",
        "distinctive",
        "flagship",
        "exceptional",
        "experiential"
      ]
    },
    "visual_freedom": {
      "type": "string"
    },
    "mandatory_routes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "trigger_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
