{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nolane.dev/schemas/runtime-live-session-v11.schema.json",
  "title": "NUI V11 Runtime Live Session",
  "type": "object",
  "required": ["version", "session_id", "target", "selected_source_digest", "state", "events"],
  "properties": {
    "version": {"const": 11},
    "session_id": {"type": "string", "minLength": 1},
    "target": {"type": "string", "minLength": 1},
    "selected_source_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "state": {
      "enum": ["SELECTED", "CONTEXT_BOUND", "VARIANTS_READY", "PREVIEWING", "ACCEPTED", "DISCARDED", "APPLIED", "REOBSERVED", "RECOVERY", "FAILED", "CLOSED"]
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["seq", "type", "from_state", "to_state", "payload"],
        "properties": {
          "seq": {"type": "integer", "minimum": 1},
          "type": {"type": "string", "minLength": 1},
          "from_state": {"type": "string", "minLength": 1},
          "to_state": {"type": "string", "minLength": 1},
          "payload": {"type": "object"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
