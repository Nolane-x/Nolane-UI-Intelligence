{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nolane.dev/schemas/runtime-live-session-v11.schema.json",
  "title": "NUI V11 Runtime Live Session",
  "type": "object",
  "required": ["version", "session_id", "target", "selected_source_digest", "state", "events"],
  "properties": {
    "version": {"const": 11},
    "session_id": {"type": "string", "minLength": 1},
    "target": {"type": "string", "minLength": 1},
    "selected_source_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "state": {
      "enum": ["SELECTED", "CONTEXT_BOUND", "VARIANTS_READY", "PREVIEWING", "ACCEPTED", "DISCARDED", "APPLIED", "REOBSERVED", "RECOVERY", "FAILED", "CLOSED"]
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["seq", "type", "from_state", "to_state", "payload"],
        "properties": {
          "seq": {"type": "integer", "minimum": 1},
          "type": {"type": "string", "minLength": 1},
          "from_state": {"type": "string", "minLength": 1},
          "to_state": {"type": "string", "minLength": 1},
          "payload": {"type": "object"}
        },
        "allOf": [
          {
            "if": {
              "properties": {"type": {"const": "reobserve"}},
              "required": ["type"]
            },
            "then": {
              "properties": {
                "payload": {
                  "type": "object",
                  "required": [
                    "runtime_closure_decision",
                    "resolved_count",
                    "persisted_count",
                    "unknown_count",
                    "regression_count"
                  ],
                  "properties": {
                    "runtime_closure_decision": {"enum": ["CLEAN", "OPEN", "UNKNOWN"]},
                    "resolved_count": {"type": "integer", "minimum": 0},
                    "persisted_count": {"type": "integer", "minimum": 0},
                    "unknown_count": {"type": "integer", "minimum": 0},
                    "regression_count": {"type": "integer", "minimum": 0}
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": {"runtime_closure_decision": {"const": "CLEAN"}},
                        "required": ["runtime_closure_decision"]
                      },
                      "then": {
                        "properties": {
                          "persisted_count": {"const": 0},
                          "unknown_count": {"const": 0},
                          "regression_count": {"const": 0}
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
