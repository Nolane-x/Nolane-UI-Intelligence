{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NUI v5 Encoding Provenance",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "channels"
  ],
  "properties": {
    "channels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "channel",
          "decorative"
        ],
        "properties": {
          "channel": {
            "type": "string",
            "minLength": 1
          },
          "meaning": {
            "type": "string"
          },
          "decorative": {
            "type": "boolean"
          },
          "source": {
            "type": "string"
          },
          "uncertainty": {
            "type": "string"
          }
        }
      }
    }
  }
}
