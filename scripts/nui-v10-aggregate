#!/usr/bin/env python3
"""Summarize V10 run JSONL without promoting unsupported efficacy claims."""
from __future__ import annotations

import json
import sys
from collections import Counter
from pathlib import Path


def main() -> int:
    if len(sys.argv) != 2:
        print("usage: nui-v10-aggregate <runs.jsonl>", file=sys.stderr)
        return 2
    path = Path(sys.argv[1])
    rows = []
    if path.exists():
        for line_no, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
            if not line.strip():
                continue
            try:
                item = json.loads(line)
            except json.JSONDecodeError as exc:
                print(f"invalid JSONL at line {line_no}: {exc}", file=sys.stderr)
                return 2
            if not isinstance(item, dict):
                print(f"run line {line_no} must be an object", file=sys.stderr)
                return 2
            rows.append(item)
    statuses = Counter(str(x.get("status", "missing")) for x in rows)
    real_rows = [x for x in rows if x.get("synthetic_example") is not True]
    families = sorted({str(x.get("model_family")) for x in real_rows if x.get("model_family")})
    treatments = sorted({str(x.get("treatment")) for x in rows if x.get("treatment")})
    payload = {
        "version": 10,
        "run_count": len(rows),
        "real_model_runs": bool(real_rows),
        "model_families": families,
        "treatments": treatments,
        "statuses": dict(sorted(statuses.items())),
        "claim_ceiling": "STRUCTURAL_ONLY",
        "claim_note": "Run presence alone is not efficacy evidence. Use blinded judgments, paired aggregation, ablation identification and the V10 claim gate before empirical promotion.",
    }
    print(json.dumps(payload, sort_keys=True, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
