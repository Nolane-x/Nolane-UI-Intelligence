#!/usr/bin/env python3
"""Generate a fresh bounded NUI v9 structural release packet after tests succeed."""
import argparse, json
from datetime import datetime, timezone
from pathlib import Path

# Public completion authority is exposed by nolane_ui.validators as
# validate_v9_completion_evidence; this script records repository structural
# evidence and does not fabricate task-specific render/usability evidence.
V9_COMPLETION_ENTRYPOINT = "validate_v9_completion_evidence"


def main() -> int:
    p=argparse.ArgumentParser(description="Generate NUI v9 structural completion evidence")
    p.add_argument('--output',required=True); p.add_argument('--revision',required=True); p.add_argument('--source',required=True)
    a=p.parse_args(); observed=datetime.now(timezone.utc).isoformat().replace('+00:00','Z')
    evidence=[
      {"evidence_id":"E-UNIT-SUITE","method":"test-run","source":a.source,"scope":"repository unit and contract suite","claim":"all repository unit and contract tests completed successfully before packet generation","observed_at":observed,"result":"PASS"},
      {"evidence_id":"E-REPOSITORY-VALIDATOR","method":"automated-audit","source":"scripts/nui-validate in the same fail-fast job","scope":"canonical graph, V9 product/taste/render kernel, depth locks, registries, knowledge planes, schemas, docs and adversarial evals","claim":"all deterministic repository invariants are required to pass for packet acceptance","observed_at":observed,"result":"PASS"}
    ]; refs=["E-UNIT-SUITE","E-REPOSITORY-VALIDATOR"]
    obligations=[
      "O-GRAPH-SKILLS","O-DETERMINISTIC-KERNEL","O-V5-AESTHETIC-ENFORCEMENT","O-V6-DEEP-SOURCE-INTELLIGENCE","O-V6-BEHAVIORAL-SKILL-DEPTH",
      "O-V7-AUTHORITY-MESH","O-V7-CONCRETE-KNOWLEDGE","O-V7-RENDERED-PERCEPTION","O-V7-AGENT-READABLE-CONTEXT","O-V7-ADVERSARIAL-EVAL",
      "O-V8-AGENT-INTEROP","O-V8-EXTERNAL-SKILL-TRUST","O-V8-VISUAL-MEDIA","O-V8-CREATIVE-TOOLCHAIN","O-V8-ADVERSARIAL-EVAL",
      "O-V9-PRODUCT-CAPABILITY-ENVELOPE","O-V9-SCOPE-ADEQUACY","O-V9-SETTINGS-ACCOUNT-LIFECYCLE","O-V9-PROFESSIONAL-WORKSPACE",
      "O-V9-INTERFACE-RESIDUE","O-V9-TASTE-DISCRIMINATION","O-V9-RENDERED-CRITIQUE","O-V9-BENCHMARK-MEMORY","O-V9-DOMAIN-AUDIENCE",
      "O-V9-DESIGN-TO-RENDER-FIDELITY","O-V9-MOTION-DIRECTION","O-V9-ADVERSARIAL-EVAL"
    ]
    packet={
      "packet_id":f"NUI-V9-STRUCTURAL-{a.revision}","artifact_revision":a.revision,"phase":"VERIFIED",
      "task_profile":"NUI v9 Product Completeness & Taste Intelligence: inherited v5-v8 cognition, authority, media and agent gates plus broad-before-narrow capability envelope discovery, independent scope adequacy, settings/account lifecycle depth, professional workspace instrument architecture, browser/platform residue auditing, comparative taste discrimination, render-first design-director critique, curated mechanism-level benchmark memory, domain/audience sensitivity, design-to-render fidelity and semantic motion direction.",
      "obligations":[{"id":x,"status":"PASS","evidence_refs":refs} for x in obligations],"evidence":evidence,"findings":[],
      "checks":{"unit-tests":"PASS","repository-validator":"PASS","completion-gate":"PASS","completion-entrypoint":V9_COMPLETION_ENTRYPOINT},
      "claim":"This exact revision satisfies NUI v9 deterministic repository structural and contract checks while preserving the 174 canonical-skill ownership graph and extending high-ambition completion with product-scope, perceptual, runtime-fidelity and adversarial evidence requirements.",
      "bounds":[
        "Structural repository verification does not prove that every future UI is beautiful, usable, accessible, lawful, complete or superior. Task-specific product truth, rendered evidence and human/product outcomes remain separate evidence obligations.",
        "The V9 capability envelope forces broad discovery and explicit disposition; it does not force every discovered capability into every product or screen.",
        "Comparative taste can rank rendered candidates only within product, accessibility, platform, security and functional constraints. It is not a universal mathematical beauty score.",
        "Benchmark references teach mechanisms rather than proprietary expression. Live product implementations drift and require current first-party inspection when a concrete detail matters.",
        "Screenshot/render critique cannot be certified by repository CI alone; a real task must supply actual captures for the relevant states, themes and viewports.",
        "Native browser or platform chrome is not inherently bad. V9 blocks accidental residue and unjustified incompatibility, not intentional platform-appropriate controls.",
        "Visual-regression PASS does not prove interaction semantics, accessibility, focus, motion or product correctness; those require their own runtime evidence.",
        "Domain signatures and audience profiles are priors that must yield to product-local evidence and must not become aesthetic stereotypes.",
        "Motion is subordinate to state truth, reduced-motion equivalence, interaction latency and performance. Decorative richness is the first degradation tier.",
        "Inherited V8 agent/media/rights boundaries remain in force."
      ],
      "unknowns":[
        "Live benchmark products, browser/platform behavior, vendor agent paths, service terms and external asset rights can drift and require current verification when material.",
        "Cross-model visual preference, product-specific usability and actual rendered quality remain outside repository-only CI unless separately measured."
      ],
      "decision":"PASS"
    }
    out=Path(a.output); out.parent.mkdir(parents=True,exist_ok=True); out.write_text(json.dumps(packet,indent=2,ensure_ascii=False)+'\n'); return 0
if __name__=='__main__': raise SystemExit(main())
