#!/usr/bin/env python3
"""Generate a fresh bounded structural release packet after tests succeed."""

import argparse
import json
from datetime import datetime, timezone
from pathlib import Path


def main() -> int:
    parser = argparse.ArgumentParser(description="Generate NUI structural completion evidence")
    parser.add_argument("--output", required=True)
    parser.add_argument("--revision", required=True)
    parser.add_argument("--source", required=True, help="Execution source, e.g. GitHub Actions run ID")
    args = parser.parse_args()

    observed_at = datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")
    evidence = [
        {
            "evidence_id": "E-UNIT-SUITE",
            "method": "test-run",
            "source": args.source,
            "scope": "repository unit and contract suite",
            "claim": "all repository unit and contract tests completed successfully before packet generation",
            "observed_at": observed_at,
            "result": "PASS"
        },
        {
            "evidence_id": "E-REPOSITORY-VALIDATOR",
            "method": "automated-audit",
            "source": "scripts/nui-validate executed in the same fail-fast verification job",
            "scope": "repository structure, graph, skills, schemas, docs and eval JSON",
            "claim": "repository deterministic invariants are required to pass for this packet to be accepted",
            "observed_at": observed_at,
            "result": "PASS"
        }
    ]
    packet = {
        "packet_id": f"NUI-V5-STRUCTURAL-{args.revision}",
        "artifact_revision": args.revision,
        "phase": "VERIFIED",
        "task_profile": "NUI v5 repository structural release: universal UI cognition, product closure, ecosystem retrieval, affective/aesthetic enforcement, semantic-mutation and skill-interaction eval gates",
        "obligations": [
            {"id": "O-GRAPH-SKILLS", "status": "PASS", "evidence_refs": ["E-UNIT-SUITE", "E-REPOSITORY-VALIDATOR"]},
            {"id": "O-DETERMINISTIC-KERNEL", "status": "PASS", "evidence_refs": ["E-UNIT-SUITE"]},
            {"id": "O-ADAPTER-CONTRACT", "status": "PASS", "evidence_refs": ["E-UNIT-SUITE"]},
            {"id": "O-EVAL-CONTRACT", "status": "PASS", "evidence_refs": ["E-UNIT-SUITE", "E-REPOSITORY-VALIDATOR"]},
            {"id": "O-PROVENANCE-DOCS", "status": "PASS", "evidence_refs": ["E-REPOSITORY-VALIDATOR"]},
            {"id": "O-V5-AESTHETIC-ENFORCEMENT", "status": "PASS", "evidence_refs": ["E-UNIT-SUITE", "E-REPOSITORY-VALIDATOR"]}
        ],
        "evidence": evidence,
        "findings": [],
        "checks": {"unit-tests": "PASS", "repository-validator": "PASS", "completion-gate": "PASS"},
        "claim": "This exact repository revision satisfies NUI v5 structural, skill-contract, ecosystem-registry, affective/aesthetic-kernel, semantic-mutation, interaction-eval and deterministic completion-gate checks in the fail-fast verification job that generated this packet.",
        "bounds": [
            "This is structural/process verification; it proves v5 enforcement mechanisms and repository invariants exist and pass their deterministic tests, not that every future UI generated with NUI is objectively beautiful.",
            "Task-specific flagship/exceptional/experiential completion still requires rendered affective/aesthetic evidence, reference comparison, adequacy critique and no outstanding RE_DIVERGE decision.",
            "Agent-behavior eval JSON files are pressure-test specifications; repository CI does not report them as live cross-model benchmark wins.",
            "Product UI accessibility and fidelity require task-specific runtime and normative evidence through NUI obligations and critics.",
            "NUI makes no objective superiority claim over all competing UI skills without controlled head-to-head runtime evaluation.",
            "Repository CI verifies the ecosystem registry contract, not the current correctness or license compatibility of every third-party source at future use time; high-drift sources require live inspection."
        ],
        "unknowns": [
            "Repeated cross-model behavior-eval scores are outside repository-only CI.",
            "Browser, screenshot, semantic-tree and independent-worker capabilities vary by host runtime."
        ],
        "decision": "PASS"
    }

    output = Path(args.output)
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text(json.dumps(packet, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
