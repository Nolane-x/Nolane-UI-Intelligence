#!/usr/bin/env python3
"""Generate a fresh bounded NUI V10 structural release packet after tests succeed."""
from __future__ import annotations

import argparse
import json
from datetime import datetime, timezone
from pathlib import Path

from nolane_ui.completion_v10 import validate_v10_completion_evidence

V10_COMPLETION_ENTRYPOINT = "validate_v10_completion_evidence"


def main() -> int:
    parser = argparse.ArgumentParser(description="Generate NUI V10 structural completion evidence")
    parser.add_argument("--output", required=True)
    parser.add_argument("--revision", required=True)
    parser.add_argument("--source", required=True)
    args = parser.parse_args()

    observed = datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")
    evidence = [
        {
            "evidence_id": "E-UNIT-SUITE",
            "method": "test-run",
            "source": args.source,
            "scope": "repository unit and contract suite",
            "claim": "all repository unit and contract tests completed successfully before packet generation",
            "observed_at": observed,
            "result": "PASS",
        },
        {
            "evidence_id": "E-REPOSITORY-VALIDATOR",
            "method": "automated-audit",
            "source": "scripts/nui-validate in the same fail-fast job",
            "scope": "canonical graph plus inherited V5-V9 gates and V10 behavioral/empirical framework",
            "claim": "all deterministic repository invariants are required to pass for packet acceptance",
            "observed_at": observed,
            "result": "PASS",
        },
    ]
    refs = ["E-UNIT-SUITE", "E-REPOSITORY-VALIDATOR"]
    obligations = [
        "O-GRAPH-SKILLS",
        "O-DETERMINISTIC-KERNEL",
        "O-V5-AESTHETIC-ENFORCEMENT",
        "O-V6-DEEP-SOURCE-INTELLIGENCE",
        "O-V6-BEHAVIORAL-SKILL-DEPTH",
        "O-V7-AUTHORITY-MESH",
        "O-V7-CONCRETE-KNOWLEDGE",
        "O-V7-RENDERED-PERCEPTION",
        "O-V8-AGENT-MEDIA-INTELLIGENCE",
        "O-V8-FLAGSHIP-VISUAL-SYNTHESIS",
        "O-V9-PRODUCT-COMPLETENESS",
        "O-V9-TASTE-AND-RENDER-CRITIQUE",
        "O-V9-DESIGN-TO-RENDER-FIDELITY",
        "O-V10-FALSIFIABLE-HYPOTHESES",
        "O-V10-BENCHMARK-CORPUS",
        "O-V10-MUTATION-ABLATION-CONTROLS",
        "O-V10-PROVENANCE-AND-BLIND-JUDGING",
        "O-V10-CLAIM-PROMOTION-BOUNDARY",
        "O-V10-ADVERSARIAL-EMPIRICAL-COURT",
    ]

    efficacy = {
        "version": 10,
        "claim_ceiling": "STRUCTURAL_ONLY",
        "empirical_runs_executed": False,
        "imported_empirical_bundle_digests": [],
        "unresolved_empirical_claims": [
            "Real-provider/model controlled runs have not been executed by repository-only CI.",
            "EMPIRICAL_LOCAL and EMPIRICAL_TRANSFER remain unavailable until validated external run bundles satisfy V10 gates.",
        ],
    }
    efficacy_check = validate_v10_completion_evidence(efficacy)
    if not efficacy_check.get("valid"):
        raise SystemExit("invalid V10 structural efficacy boundary: " + "; ".join(efficacy_check.get("errors", [])))

    packet = {
        "packet_id": f"NUI-V10-STRUCTURAL-{args.revision}",
        "artifact_revision": args.revision,
        "phase": "VERIFIED",
        "task_profile": (
            "NUI V10 Design Cognition & Empirical Proof: inherited product, visual, authority, media, "
            "product-completeness and rendered-perception gates plus falsifiable hypotheses, controlled "
            "benchmark tasks, mutations/ablations/placebos, run provenance, blind judging and bounded claim promotion."
        ),
        "obligations": [{"id": item, "status": "PASS", "evidence_refs": refs} for item in obligations],
        "evidence": evidence,
        "findings": [],
        "checks": {"unit-tests": "PASS", "repository-validator": "PASS", "completion-gate": "PASS"},
        "completion_entrypoint": V10_COMPLETION_ENTRYPOINT,
        "v10_efficacy_boundary": efficacy,
        "claim_ceiling": "STRUCTURAL_ONLY",
        "claim": (
            "This exact revision satisfies NUI V10 deterministic repository structural and contract checks, "
            "preserves the canonical graph above the historical V10 baseline, and contains the V10 empirical evaluation framework. "
            "Repository-only CI does not claim real-model efficacy."
        ),
        "bounds": [
            "Structural repository verification does not prove every future UI is beautiful, usable, accessible, safe, lawful, complete or superior.",
            "A strong artifact is not proof that NUI caused the improvement; efficacy requires controlled real-model evidence.",
            "EMPIRICAL_LOCAL requires a validated real-run bundle, matched pairs, blinded judging and targeted ablation evidence.",
            "EMPIRICAL_TRANSFER additionally requires genuine holdout evidence and positive direction across multiple model families.",
            "Task-specific rendered perception, product truth and human outcomes remain separate evidence obligations.",
            "External sources transfer bounded mechanisms, not recognizable trade dress or global authority.",
        ],
        "unknowns": [
            "Cross-model efficacy remains unverified until real provider/model experiments are imported and validated.",
            "Live platforms, external libraries, standards, service terms and asset rights can drift and require current verification when material.",
        ],
        "decision": "PASS",
    }

    output = Path(args.output)
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text(json.dumps(packet, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
