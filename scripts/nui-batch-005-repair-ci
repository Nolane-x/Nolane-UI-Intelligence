#!/usr/bin/env python3
"""One-shot CI contract repair for Batch 005 integration.

This script changes tests only. It never reads, creates, rewrites, or transforms
canonical SKILL.md prose.
"""
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]


def replace_exact(path: Path, old: str, new: str, expected: int = 1):
    text = path.read_text(encoding="utf-8")
    count = text.count(old)
    if count != expected:
        raise RuntimeError(f"{path}: expected {expected} occurrence(s), found {count}: {old!r}")
    path.write_text(text.replace(old, new), encoding="utf-8")


# Batch 004 must prove its 674-node baseline remains present, not prohibit later
# independently admitted extensions. Batch 002/003 already use this monotonic rule.
b4 = ROOT / "tests" / "test_ui_industry_batch_004.py"
replace_exact(
    b4,
    "    def test_final_graph_count_is_exactly_674(self):\n        self.assertEqual(674, len(self.graph_skills))",
    "    def test_graph_preserves_batch_004_baseline_at_or_above_674(self):\n        self.assertGreaterEqual(len(self.graph_skills), 674)",
)

# Clean-delivery current-state policy must move with the canonical graph and must
# require the new provenance record. Historical 274/374/674 evidence elsewhere is
# not rewritten.
clean = ROOT / "tests" / "test_clean_delivery_contract.py"
replace_exact(
    clean,
    '            ROOT / "docs" / "research" / "UI-INDUSTRY-1000-BATCH-004.md",\n',
    '            ROOT / "docs" / "research" / "UI-INDUSTRY-1000-BATCH-004.md",\n            ROOT / "docs" / "research" / "UI-INDUSTRY-1000-BATCH-005.md",\n',
)
replace_exact(
    clean,
    "    def test_repository_policy_matches_the_674_node_batch_004_graph(self):\n        agents = (ROOT / \"AGENTS.md\").read_text(encoding=\"utf-8\")\n        self.assertIn(\"**674 canonical skills**\", agents)\n        self.assertIn(\"500 independently owned UI-industry specialists\", agents)",
    "    def test_repository_policy_matches_the_774_node_batch_005_graph(self):\n        agents = (ROOT / \"AGENTS.md\").read_text(encoding=\"utf-8\")\n        self.assertIn(\"**774 canonical skills**\", agents)\n        self.assertIn(\"600 independently owned UI-industry specialists\", agents)",
)

# Character-level SequenceMatcher made the monotonic batch suite grow to several
# minutes per court because each prose body contains thousands of characters.
# Trivial rename is a word-sequence property: compare normalized word tokens while
# preserving each batch's existing threshold. Exact normalized duplicates remain a
# separate gate; Batch 005 also retains mass-reused-paragraph detection.
for name in (
    "test_ui_industry_batch_002.py",
    "test_ui_industry_batch_003.py",
    "test_ui_industry_batch_004.py",
    "test_ui_industry_batch_005.py",
):
    path = ROOT / "tests" / name
    text = path.read_text(encoding="utf-8")
    old_false = "difflib.SequenceMatcher(None, bodies[left], bodies[right], autojunk=False)"
    old_default = "difflib.SequenceMatcher(None, bodies[left], bodies[right])"
    new = "difflib.SequenceMatcher(None, bodies[left].split(), bodies[right].split(), autojunk=False)"
    count = text.count(old_false) + text.count(old_default)
    if count != 1:
        raise RuntimeError(f"{path}: expected one SequenceMatcher pair, found {count}")
    text = text.replace(old_false, new).replace(old_default, new)
    path.write_text(text, encoding="utf-8")

print("Batch 005 CI contract repair complete: historical baselines monotonic; rename gate tokenized")
