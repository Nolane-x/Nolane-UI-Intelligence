#!/usr/bin/env python3
from __future__ import annotations
import argparse, json, sys
from pathlib import Path
ROOT=Path(__file__).resolve().parents[1]
sys.path.insert(0,str(ROOT/'src'))
from nolane_ui.source_intelligence import validate_source_research_dossier

def main()->int:
    p=argparse.ArgumentParser(description='Audit an NUI v6 deep source research dossier')
    p.add_argument('dossier')
    p.add_argument('--source', help='optional source descriptor used for drift/live-verification requirements')
    a=p.parse_args()
    dossier=json.loads(Path(a.dossier).read_text(encoding='utf-8'))
    source=json.loads(Path(a.source).read_text(encoding='utf-8')) if a.source else None
    result=validate_source_research_dossier(dossier, source)
    print(json.dumps(result, indent=2, ensure_ascii=False))
    return 0 if result['valid'] else 2
if __name__=='__main__': raise SystemExit(main())
