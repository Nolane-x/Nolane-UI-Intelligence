#!/usr/bin/env python3
import argparse
import sys
from pathlib import Path

DEFAULT_ROOT=Path(__file__).resolve().parents[1]
def main() -> int:
    p=argparse.ArgumentParser(description="Run NUI v8 bounded local MCP server")
    p.add_argument("--root", default=str(DEFAULT_ROOT))
    args=p.parse_args(); root=Path(args.root).resolve(); sys.path.insert(0,str(root/"src"))
    from nolane_ui.mcp_server import run_server
    run_server(root)
    return 0
if __name__=="__main__": raise SystemExit(main())
